{
  "project": "briefcast",
  "test": [
    {
      "name": "Go tests",
      "run": "go test ./...",
      "dir": "."
    },
    {
      "name": "Integration regression",
      "run": "go test ./service -run TestIntegrationFeedDownloadWhisperX",
      "dir": "."
    },
    {
      "name": "Frontend typecheck + build",
      "run": "npm run build",
      "dir": "frontend"
    },
    {
      "name": "Python lint (ruff)",
      "run": "uv run ruff check .",
      "dir": "."
    },
    {
      "name": "Python typecheck (mypy)",
      "run": "uv run mypy src",
      "dir": "."
    },
    {
      "name": "Python tests (pytest)",
      "run": "uv run pytest",
      "dir": "."
    }
  ],
  "images": [
    {
      "name": "briefcast",
      "variant": "app",
      "dockerfile": "Dockerfile",
      "build_args": {
        "APP_VERSION": "{version}"
      },
      "service": "briefcast",
      "env_key": "BRIEFCAST_IMAGE"
    },
    {
      "name": "briefcast-whisperx-cpu",
      "variant": "cpu",
      "dockerfile": "docker/whisperx/Dockerfile",
      "build_args": {
        "WORKER_VERSION": "{version}",
        "RUNTIME": "cpu"
      },
      "service": "whisperx",
      "env_key": "WHISPERX_IMAGE"
    },
    {
      "name": "briefcast-whisperx-cu128",
      "variant": "cu128",
      "dockerfile": "docker/whisperx/Dockerfile",
      "build_args": {
        "WORKER_VERSION": "{version}",
        "RUNTIME": "cu128"
      },
      "service": "whisperx",
      "env_key": "WHISPERX_IMAGE"
    }
  ],
  "deploy": {
    "compose_modes": "docker/compose-modes.json",
    "minimum_compose": "2.24.0",
    "env_file": ".env",
    "app_service": "briefcast",
    "worker_service": "whisperx"
  },
  "git": {
    "exclude_paths": [
      ".claude/worktrees",
      ".claude/worktrees/**"
    ]
  },
  "versions": {
    "app": {
      "file": "pyproject.toml",
      "sync": [
        "frontend/package.json"
      ]
    },
    "worker": {
      "file": "docker/whisperx/VERSION",
      "sync": []
    }
  }
}
