# End-user Docker runtime settings used by docker-compose.yml

# Build briefcast:local for development. For deployment, use the release digest.
# BRIEFCAST_IMAGE=ghcr.io/ctaylor1/briefcast@sha256:<release-digest>
BRIEFCAST_IMAGE=briefcast:local

# Container name used by docker-compose.yml.
BRIEFCAST_CONTAINER_NAME=briefcast

# Host paths for persistent data.
HOST_CONFIG_DIR=./config
HOST_ASSETS_DIR=./assets
HOST_LOGS_DIR=./logs

# Published host port.
HOST_PORT=8080

# Scheduler interval in minutes.
CHECK_FREQUENCY=15

# Optional basic auth password (username is always "briefcast").
PASSWORD=

# Logging.
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout,file:/logs/briefcast-{startup_ts}.log

# Optional ownership mapping for NAS/Linux hosts.
PUID=1000
PGID=1000

# Optional DB override (default is sqlite:///config/briefcast.db).
DATABASE_URL=sqlite:///config/briefcast.db

# Optional DB override (Postgres example):
# DB_DRIVER=postgres
# BRIEFCAST_DB_PASSWORD=change-me
# DATABASE_URL=postgres://operator:${BRIEFCAST_DB_PASSWORD}@192.168.1.2:5432/briefcast?sslmode=disable

# WhisperX simple toggles.
WHISPERX_ENABLED=false
WHISPERX_DIARIZATION=false
WHISPERX_CHECK_FREQUENCY=30
WHISPERX_MAX_CONCURRENCY=1
WHISPERX_CHUNK_SECONDS=120
WHISPERX_PROGRESS_POLL_MILLIS=2000
WHISPERX_LOCK_DURATION_MINUTES=30
WHISPERX_LOCK_REFRESH_SECONDS=60

# Optional advanced WhisperX overrides file.
# Create .env.whisperx from whisperx.env.example when needed.
WHISPERX_ENV_FILE=.env.whisperx

# Explicit packaging mode: disabled | cpu | cuda (used by just/RELEASE.ps1).
WHISPERX_RUNTIME=disabled
# Enable WHISPERX_ENABLED and supply an immutable image when selecting a worker.
# WHISPERX_IMAGE=ghcr.io/ctaylor1/briefcast-whisperx@sha256:<release-digest>
HOST_WHISPERX_STATE_DIR=./worker-state
HOST_WHISPERX_CACHE_DIR=./worker-cache
HOST_WHISPERX_TOKEN_FILE=./secrets/whisperx-service-token
# Empty file is valid when no gated models are used.
HOST_WHISPERX_HF_TOKEN_FILE=./secrets/whisperx-hf-token
WHISPERX_UID=1000
WHISPERX_GID=1000
WHISPERX_OFFLINE=true
WHISPERX_WORKER_BATCH_SIZE=16
WHISPERX_WORKER_MAX_RUNNING=1
WHISPERX_WORKER_MAX_WAITING=4

# LLM Summarization (requires WHISPERX transcripts).
# Uses any OpenAI-compatible API (OpenAI, Ollama, LM Studio, vLLM, Azure OpenAI).
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=120
# Leave blank to use the built-in default system prompt in service/summarize.go.
LLM_SUMMARIZATION_PROMPT=
