# Optional advanced WhisperX overrides.
# Copy this file to .env.whisperx and edit only what you need.
# The Compose wrapper loads it after the primary env file when it exists.
# Only the app reads this file; worker configuration is explicitly mapped.

# Core model/runtime.
WHISPERX_MODEL=medium.en
WHISPERX_LANGUAGE=en
WHISPERX_DEVICE=auto
WHISPERX_COMPUTE_TYPE=auto
WHISPERX_BATCH_SIZE=0
WHISPERX_CHUNK_SECONDS=120

# Decoder tuning.
WHISPERX_BEAM_SIZE=5
WHISPERX_PATIENCE=1
WHISPERX_CONDITION_ON_PREVIOUS_TEXT=true
WHISPERX_INITIAL_PROMPT="Podcast interview. Speakers are Host and Guest. Use punctuation and capitalization."

# VAD + alignment.
WHISPERX_VAD_CHUNK_SIZE=45
WHISPERX_VAD_ONSET=0.50
WHISPERX_VAD_OFFSET=0.50
WHISPERX_VAD_METHOD=pyannote
WHISPERX_ALIGN=true

# Speaker diarization.
WHISPERX_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
WHISPERX_MIN_SPEAKERS=2
WHISPERX_MAX_SPEAKERS=2
# Required only if diarization is enabled and pyannote is used.
# Worker gated-model credentials use HOST_WHISPERX_HF_TOKEN_FILE, not an env value.

# Worker behavior.
WHISPERX_MAX_CONCURRENCY=1
WHISPERX_MAX_ITEMS=0
WHISPERX_RETRY_FAILED=true
WHISPERX_RETRY_DELAY_SECONDS=300
WHISPERX_RETRY_MAX_DELAY_SECONDS=21600
WHISPERX_PROGRESS_POLL_MILLIS=2000
# Lock lease controls for long-running transcription batches.
WHISPERX_LOCK_DURATION_MINUTES=30
WHISPERX_LOCK_REFRESH_SECONDS=60

# Optional runtime/script overrides.
WHISPERX_PYTHON=
WHISPERX_SCRIPT=
WHISPERX_TIMEOUT_SECONDS=21600

# Optional stability defaults for NAS/offline-ish hosts.
# Persist Hugging Face cache outside transient container root.
# Local transitional backend only; remote worker caches are at /cache.
# WHISPERX_HF_HOME=/config/.cache/huggingface
# Disable external telemetry endpoints to avoid long retry stalls.
WHISPERX_DISABLE_TELEMETRY=true
# Keep dependency log noise out of app logs when LOG_LEVEL=debug.
WHISPERX_THIRD_PARTY_LOG_LEVEL=warning
